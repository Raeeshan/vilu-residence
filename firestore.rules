rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'viluresidence@gmail.com';
    }
    function isStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff_permissions/$(request.auth.uid));
    }
    function isAgency() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'agency';
    }
    // Manager (Fixed Price Catalog Integration, 2026-09-10): a 4th peer role
    // value alongside admin/staff/agency, stored the same way isAgency()
    // reads it -- users/{email}.role == 'manager'. Manager gets everything
    // Staff gets (added as `|| isManagerRole()` next to every isStaff() use
    // below, rather than piggybacking on the staff_permissions doc, since
    // that doc's own UI toggle is staff-only ("can modify bookings") and
    // provisioning it for Manager would need new UI this task doesn't
    // build) PLUS master-catalog/discount authority (service_catalog
    // writes, folio discount/override fields below).
    function isManagerRole() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'manager';
    }
    function canDiscount() {
      return isAdmin() || isManagerRole();
    }
    function isCancellingNow() {
      return request.resource.data.status == 'Cancelled' && resource.data.status != 'Cancelled';
    }
    function validOverrideCode() {
      return request.resource.data.cancellationAttemptId is string &&
        get(/databases/$(database)/documents/cancellation_attempts/$(request.resource.data.cancellationAttemptId)).data.overrideCode
          == get(/databases/$(database)/documents/admin_settings/security).data.cancellationOverrideCode;
    }
    // Shared by create/update: check-out must be strictly after check-in, and
    // the rate must be a sane, in-range number. Doesn't attempt to validate
    // the *exact* seasonal price (that logic lives in pmGetPrice() and is too
    // involved to safely mirror in rules without risking false rejections on
    // legitimate bookings) — just catches malformed or absurd values, which
    // covers the case that actually matters: a raw API write bypassing the
    // app's own client-side checks entirely.
    function validReservationShape() {
      return request.resource.data.check_out > request.resource.data.check_in
        && request.resource.data.rate is number
        && request.resource.data.rate >= 0
        && request.resource.data.rate < 100000;
    }

    match /reservations/{id} {
      allow read: if isAdmin() || isStaff() || isManagerRole() || (isAgency() && resource.data.agencyId == request.auth.uid);
      allow create: if request.resource.data.room_id is string
                    && request.resource.data.check_in is string
                    && request.resource.data.check_out is string
                    && validReservationShape()
                    && (
                      isAdmin() || isStaff() || isManagerRole() ||
                      (isAgency() && request.resource.data.agencyId == request.auth.uid && request.resource.data.source == 'Agency') ||
                      (request.auth == null && request.resource.data.source == 'Website' && !('agencyId' in request.resource.data) && request.resource.data.status == 'Pending')
                    );
      allow update: if request.resource.data.room_id is string
                    && request.resource.data.check_in is string
                    && request.resource.data.check_out is string
                    && validReservationShape()
                    && (isAdmin() || ((isStaff() || isManagerRole()) && (!isCancellingNow() || validOverrideCode())));
      allow delete: if false;
    }

    // Durable, append-only audit trail for reservation-specific price
    // overrides (Financial integrity correction, 2026-09-10). Written in
    // the SAME Firestore transaction as the reservations/{id} rate change
    // itself (see writeReservation()'s client code) so the two can never
    // drift apart -- either both succeed or neither does. Admin/Manager
    // only, enforced here (not just by hiding the UI control): a Staff
    // session attempting to forge this write fails its own rule, which
    // fails the WHOLE transaction atomically, so the reservation's rate
    // change is rejected right along with it -- Staff cannot achieve a
    // price override with or without an audit trail. changedByUid must
    // match the authenticated caller, so the audit trail can never record
    // a fabricated actor. Never updatable or deletable once written.
    match /reservation_price_adjustments/{id} {
      allow read: if isAdmin() || isStaff() || isManagerRole();
      allow create: if (isAdmin() || isManagerRole())
        && request.resource.data.reservationId is string
        && request.resource.data.oldRate is number
        && request.resource.data.newRate is number
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0
        && request.resource.data.changedByUid == request.auth.uid
        && request.resource.data.source == 'pms'
        && request.resource.data.changedAt == request.time;
      allow update, delete: if false;
    }

    match /blocks/{id} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    match /rooms/{id} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    match /website_content/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    match /room_availability/{roomId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }
    match /reconciliation_log/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    // Guest Folio unification (2026-09-10): the ONE canonical charge ledger
    // per reservation, shared by the Calendar reservation-detail folio and
    // the standalone Guest Folios page (never a public/agency-readable
    // collection -- this is internal financial detail, not guest-facing
    // pricing like rooms/room_prices above).
    // NOTE on discount/override enforcement (Fixed Price Catalog Integration,
    // 2026-09-10): each folio doc stores its charges as ONE array field,
    // rewritten whole on every save (see syncFolioToFirestore) rather than
    // one Firestore doc per charge line. Rules can't iterate that array to
    // validate a specific line's discountType/discountValue/overridePrice
    // fields without either a schema change (one doc per charge) or a
    // request.resource.data.charges.hasAny()-style check too brittle to
    // trust here (same "proved unreliable" territory storage.rules already
    // documents for cross-service checks) -- so per-item discount authority
    // (Staff cannot discount; Manager/Admin can, per canDiscount()) is
    // enforced at the UI level only (canDiscount() gates the discount/
    // override controls), same as this app already does for other
    // judgment-heavy in-document fields. Collection-level write access
    // (any charge at all) stays isAdmin()/isStaff()/isManagerRole(), matching
    // every other operational collection above.
    match /folios/{resId} {
      allow read: if isAdmin() || isStaff() || isManagerRole();
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }
    // Generated invoices -- previously an in-memory-only JS array (INV)
    // with no persistence at all; now durable and shared across every
    // staff session, same access pattern as reservations/folios.
    match /invoices/{invId} {
      allow read: if isAdmin() || isStaff() || isManagerRole();
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }
    // Fixed Price service catalog (Fixed Price Catalog Integration,
    // 2026-09-10) -- the ONE canonical master item/price list (name,
    // category, basePrice, unitType, active). Read is broader than write:
    // Staff need to browse active items when adding a folio charge, but
    // only Admin/Manager may create/edit/deactivate items or change a
    // master price. `allow delete: if false` hard-enforces "no hard
    // delete, ever" (Part 5) at the rules level, not just by omitting a
    // delete button in the UI -- mirrors the same pattern already used for
    // /reservations above. Deactivation is a normal field update
    // (active:false), which stays allowed.
    match /service_catalog/{itemId} {
      allow read: if isAdmin() || isStaff() || isManagerRole();
      allow create, update: if (isAdmin() || isManagerRole())
        && request.resource.data.name is string
        && request.resource.data.category in ['TRIPS_ACTIVITIES','FOOD_BEVERAGE','TRANSFER','OTHER_SERVICE','ACCOMMODATION_EXTRA']
        && request.resource.data.unitType in ['PER_PAX','PER_TRIP','PER_ITEM','PER_NIGHT','PER_ROOM','PER_HOUR']
        && request.resource.data.basePrice is number
        && request.resource.data.basePrice >= 0
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    // Reservation Document Vault (Part A, Document Vault + Catalog +
    // Invoice Center, 2026-09-10). One record per uploaded document,
    // metadata only -- the actual file bytes live in Storage under
    // reservation-documents/{resId}/{documentId} (see storage.rules).
    // Sensitive types (passport/ID/visa) are read-restricted to
    // Admin/Manager only, matching Part A3/F's least-privilege
    // requirement; Staff may read non-sensitive types (signed bills,
    // invoices, receipts, transfer docs, other). Never hard-deleted (A7)
    // -- `allow delete: if false` mirrors reservation_price_adjustments
    // above; ordinary Staff may only toggle status active<->archived
    // (an "Archive" action, not a rewrite of the document's identity),
    // while Admin/Manager may update any field per role policy.
    match /reservation_documents/{docId} {
      allow read: if isAdmin() || isManagerRole()
        || (isStaff() && !(resource.data.type in ['PASSPORT','IDENTITY','TRAVEL']));
      allow create: if (isAdmin() || isManagerRole() || isStaff())
        && request.resource.data.reservationId is string
        && request.resource.data.type in ['PASSPORT','IDENTITY','TRAVEL','TRANSFER','SIGNED_BILL','INVOICE','RECEIPT','OTHER']
        && request.resource.data.title is string
        && request.resource.data.storagePath is string
        && request.resource.data.uploadedByUid == request.auth.uid
        && request.resource.data.uploadedAt == request.time
        && request.resource.data.status == 'active';
      allow update: if isAdmin() || isManagerRole()
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','archivedAt','archivedBy'])
            && request.resource.data.status in ['active','archived']);
      allow delete: if false;
    }

    // Payment-status change audit trail (Part C17). Append-only, mirrors
    // reservation_price_adjustments -- previous status/amount, new
    // status/amount, method, reference, who, and a server timestamp that
    // can't be spoofed by a client clock. Staff may create entries (they
    // can change payment status if their invoice-edit permissions allow
    // it in the UI) but nothing can be edited or deleted after the fact.
    match /invoice_payment_audit/{id} {
      allow read: if isAdmin() || isStaff() || isManagerRole();
      allow create: if (isAdmin() || isStaff() || isManagerRole())
        && request.resource.data.invoiceId is string
        && request.resource.data.previousStatus is string
        && request.resource.data.newStatus is string
        && request.resource.data.changedByUid == request.auth.uid
        && request.resource.data.changedAt == request.time;
      allow update, delete: if false;
    }

    match /users/{id} {
      // Full-collection listing (the User Management panel) is admin/staff
      // only; anyone else can only ever read their own profile doc — this
      // is what was missing before: `allow read: if true` let an
      // unauthenticated request list every agency's commission rate, name,
      // and email in one call. isAgency()/isStaff() elsewhere in this file
      // use get() on this same path internally, which bypasses this read
      // rule entirely (rules-internal get()/exists() always succeed), so
      // tightening this doesn't touch that.
      allow read: if isAdmin() || isStaff() || isManagerRole() || (request.auth != null && request.auth.token.email.lower() == id);
      // Self-service writes may never change `role` (existing) or
      // `commission` (added) — both are admin-set fields with no legitimate
      // self-edit path in the app. `uid` is deliberately left self-writable:
      // authenticateUser()/restoreSession() backfill it onto a caller's own
      // doc the first time they log in after an account was created without
      // one, and that's the only place a non-admin ever writes it.
      allow write: if isAdmin() || (
        request.auth != null && request.auth.token.email.lower() == id &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('commission', null) == resource.data.get('commission', null)
      );
    }

    match /staff_permissions/{staffUid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == staffUid);
      allow write: if isAdmin();
    }

    match /admin_settings/security { allow read, write: if isAdmin(); }
    match /cancellation_attempts/{attemptId} { allow create: if request.auth != null; allow read, update, delete: if false; }

    // ── OTA / channel-manager core (read-only additive rules) ──
    // Every write to these collections happens ONLY through Cloud Functions
    // using the Admin SDK, which bypasses these rules entirely — so no
    // `allow write` clause is needed or given here for any client, including
    // admin/staff. These rules exist solely so the future PMS "Sync log" /
    // "OTA channels" screens can read the real data once built; today
    // nothing in the client reads these collections yet.
    match /ota_config/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if false; }
    match /ota_events/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if false; }
    match /ota_conflicts/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if false; }
    match /ota_pushes/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if false; }
    match /ota_queue/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if false; }
    match /availability_outbound/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if false; }
    // OTA room-type commercial model (Beds24 pre-integration stage, additive):
    // separate from physical-room pricing (room_prices/room_details above) and
    // from live PMS rates -- staff/admin can configure it exactly like any
    // other pricing-adjacent collection, but nothing reads or writes it from
    // the public site, and no Cloud Function pushes it externally yet.
    match /ota_room_types/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if isAdmin() || isStaff() || isManagerRole(); }
    match /ota_room_type_overrides/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if isAdmin() || isStaff() || isManagerRole(); }
    // rate_limits stores only a salted hash + a count, never guest PII; kept
    // fully server-only (not even admin/staff read) since it has no UI use.
    match /rate_limits/{id} { allow read, write: if false; }
    match /block_requests/{id} {
      allow create: if request.auth != null && request.resource.data.agencyId == request.auth.uid;
      allow read: if request.auth != null && (isAdmin() || isStaff() || isManagerRole() || resource.data.agencyId == request.auth.uid);
      allow update: if isAdmin() || isStaff() || isManagerRole();
      allow delete: if false;
    }

    match /packages/{packageId} {
      allow read: if isAdmin() || isStaff() || isManagerRole()
        || resource.data.get('visibleToAgencies', 'all') == 'all'
        || (request.auth != null
            && resource.data.visibleToAgencies is list
            && request.auth.token.email.lower() in resource.data.visibleToAgencies);
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    // Per-agency package copies - each agency's own customized package set,
    // keyed by their email. Only that specific agency (or admin) can read it;
    // only admin can write it (matches how packages/room_details are admin-managed).
    match /agency_packages/{email} {
      allow read: if request.auth != null &&
        (request.auth.token.email.lower() == email || isAdmin());
      allow write: if isAdmin();
    }

    match /room_prices/{roomId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    match /room_details/{roomId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    // Guest reviews - manually entered OTA reviews + platform aggregate
    // ratings. Admin-only write (matches the Transportation panel's
    // admin-only access pattern), public read so the website can display
    // reviews without requiring a login.
    match /manual_reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /platform_ratings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
