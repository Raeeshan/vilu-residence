rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'viluresidence@gmail.com';
    }
    function isStaff() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff_permissions/$(request.auth.uid));
    }
    function isAgency() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'agency';
    }
    // Manager (Fixed Price Catalog Integration, 2026-09-10): a 4th peer role
    // value alongside admin/staff/agency, stored the same way isAgency()
    // reads it -- users/{email}.role == 'manager'. Manager gets everything
    // Staff gets (added as `|| isManagerRole()` next to every isStaff() use
    // below, rather than piggybacking on the staff_permissions doc, since
    // that doc's own UI toggle is staff-only ("can modify bookings") and
    // provisioning it for Manager would need new UI this task doesn't
    // build) PLUS master-catalog/discount authority (service_catalog
    // writes, folio discount/override fields below).
    function isManagerRole() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data.role == 'manager';
    }
    function canDiscount() {
      return isAdmin() || isManagerRole();
    }
    function isCancellingNow() {
      return request.resource.data.status == 'Cancelled' && resource.data.status != 'Cancelled';
    }
    function validOverrideCode() {
      return request.resource.data.cancellationAttemptId is string &&
        get(/databases/$(database)/documents/cancellation_attempts/$(request.resource.data.cancellationAttemptId)).data.overrideCode
          == get(/databases/$(database)/documents/admin_settings/security).data.cancellationOverrideCode;
    }
    // Shared by create/update: check-out must be strictly after check-in, and
    // the rate must be a sane, in-range number. Doesn't attempt to validate
    // the *exact* seasonal price (that logic lives in pmGetPrice() and is too
    // involved to safely mirror in rules without risking false rejections on
    // legitimate bookings) — just catches malformed or absurd values, which
    // covers the case that actually matters: a raw API write bypassing the
    // app's own client-side checks entirely.
    function validReservationShape() {
      return request.resource.data.check_out > request.resource.data.check_in
        && request.resource.data.rate is number
        && request.resource.data.rate >= 0
        && request.resource.data.rate < 100000;
    }

    match /reservations/{id} {
      // Agency Sales Workflow Phase I security fix (I-17, 2026-09-11): the
      // isAgency()-own-reservation READ branch that used to live here is
      // REMOVED. reservations is one shared schema across Direct/OTA/Agency
      // sources -- PMS staff write internal_note (explicitly staff-only,
      // see reservation_note_history's own noteType gating) and notes
      // (which can carry Cloudbeds-imported internal notes, balance-due
      // figures, guest address, appended staff-note blocks) onto the SAME
      // document an agency's own reservation lives on. Firestore rules can
      // only allow or deny a WHOLE document, never redact individual
      // fields, so granting agencyId==auth.uid a direct read meant every
      // one of those fields reached the agency's browser the moment Phase
      // H's My Bookings list or the calendar's own-booking lookup ran a
      // plain client query -- neither ever rendered them, but both
      // downloaded them. getMyAgencyBookings() (functions-core/index.js,
      // Phase I) is the safe replacement -- an explicit projection with
      // none of those fields -- and is now the ONLY path an agency's own
      // reservation data can reach the browser through. See
      // test/agency-security-rules.test.js's I-17 test for the proof.
      allow read: if isAdmin() || isStaff() || isManagerRole();
      // Agency Sales Workflow Phase F cutover (2026-09-11): the
      // isAgency()-direct-create branch that used to live here is REMOVED.
      // An agency can no longer write reservations/{id} directly at all --
      // the only path from an agency's action to a real reservation is now
      // confirmAgencyBookingRequest() (functions-core/index.js), which uses
      // the Admin SDK and bypasses these rules entirely after its own
      // server-side availability recheck and ownership validation. See
      // test/agency-booking-requests-rules.test.js's Part 26 attack test
      // for the proof this specific removal closes the old direct-write
      // path.
      allow create: if request.resource.data.room_id is string
                    && request.resource.data.check_in is string
                    && request.resource.data.check_out is string
                    && validReservationShape()
                    && (
                      isAdmin() || isStaff() || isManagerRole() ||
                      (request.auth == null && request.resource.data.source == 'Website' && !('agencyId' in request.resource.data) && request.resource.data.status == 'Pending')
                    );
      allow update: if request.resource.data.room_id is string
                    && request.resource.data.check_in is string
                    && request.resource.data.check_out is string
                    && validReservationShape()
                    && (isAdmin() || ((isStaff() || isManagerRole()) && (!isCancellingNow() || validOverrideCode())));
      allow delete: if false;
    }

    // Durable, append-only audit trail for reservation-specific price
    // overrides (Financial integrity correction, 2026-09-10). Written in
    // the SAME Firestore transaction as the reservations/{id} rate change
    // itself (see writeReservation()'s client code) so the two can never
    // drift apart -- either both succeed or neither does. Admin/Manager
    // only, enforced here (not just by hiding the UI control): a Staff
    // session attempting to forge this write fails its own rule, which
    // fails the WHOLE transaction atomically, so the reservation's rate
    // change is rejected right along with it -- Staff cannot achieve a
    // price override with or without an audit trail. changedByUid must
    // match the authenticated caller, so the audit trail can never record
    // a fabricated actor. Never updatable or deletable once written.
    match /reservation_price_adjustments/{id} {
      allow read: if isAdmin() || isStaff() || isManagerRole();
      allow create: if (isAdmin() || isManagerRole())
        && request.resource.data.reservationId is string
        && request.resource.data.oldRate is number
        && request.resource.data.newRate is number
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0
        && request.resource.data.changedByUid == request.auth.uid
        && request.resource.data.source == 'pms'
        && request.resource.data.changedAt == request.time;
      allow update, delete: if false;
    }

    // Reservation note-edit audit trail (Notes editing fix, 2026-09-10).
    // Append-only, same shape as reservation_price_adjustments above --
    // one durable record per Guest/Internal note edit (noteType
    // distinguishes them), old/new text, who, and a server-authoritative
    // timestamp a client can't spoof. Guest Notes are Staff-editable
    // (canEdit() parity), Internal Notes are Admin/Manager-only
    // (canEditInternalNotes()) -- both write through this same collection,
    // create is gated to whichever role is actually allowed to write that
    // noteType so a Staff session can't forge an 'internal' history entry
    // even by hand-crafting the create call.
    match /reservation_note_history/{id} {
      allow read: if isAdmin() || isStaff() || isManagerRole();
      allow create: if request.resource.data.reservationId is string
        && request.resource.data.noteType in ['guest','internal']
        && request.resource.data.oldText is string
        && request.resource.data.newText is string
        && request.resource.data.changedByUid == request.auth.uid
        && request.resource.data.changedAt == request.time
        && (
          (request.resource.data.noteType == 'guest' && (isAdmin() || isStaff() || isManagerRole())) ||
          (request.resource.data.noteType == 'internal' && (isAdmin() || isManagerRole()))
        );
      allow update, delete: if false;
    }

    match /blocks/{id} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    match /rooms/{id} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    match /website_content/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    match /room_availability/{roomId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }
    match /reconciliation_log/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    // Guest Folio unification (2026-09-10): the ONE canonical charge ledger
    // per reservation, shared by the Calendar reservation-detail folio and
    // the standalone Guest Folios page (never a public/agency-readable
    // collection -- this is internal financial detail, not guest-facing
    // pricing like rooms/room_prices above).
    // NOTE on discount/override enforcement (Fixed Price Catalog Integration,
    // 2026-09-10): each folio doc stores its charges as ONE array field,
    // rewritten whole on every save (see syncFolioToFirestore) rather than
    // one Firestore doc per charge line. Rules can't iterate that array to
    // validate a specific line's discountType/discountValue/overridePrice
    // fields without either a schema change (one doc per charge) or a
    // request.resource.data.charges.hasAny()-style check too brittle to
    // trust here (same "proved unreliable" territory storage.rules already
    // documents for cross-service checks) -- so per-item discount authority
    // (Staff cannot discount; Manager/Admin can, per canDiscount()) is
    // enforced at the UI level only (canDiscount() gates the discount/
    // override controls), same as this app already does for other
    // judgment-heavy in-document fields. Collection-level write access
    // (any charge at all) stays isAdmin()/isStaff()/isManagerRole(), matching
    // every other operational collection above.
    match /folios/{resId} {
      allow read: if isAdmin() || isStaff() || isManagerRole();
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }
    // Generated invoices -- previously an in-memory-only JS array (INV)
    // with no persistence at all; now durable and shared across every
    // staff session, same access pattern as reservations/folios.
    match /invoices/{invId} {
      allow read: if isAdmin() || isStaff() || isManagerRole();
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }
    // Fixed Price service catalog (Fixed Price Catalog Integration,
    // 2026-09-10) -- the ONE canonical master item/price list (name,
    // category, basePrice, unitType, active). Read is broader than write:
    // Staff need to browse active items when adding a folio charge, but
    // only Admin/Manager may create/edit/deactivate items or change a
    // master price. `allow delete: if false` hard-enforces "no hard
    // delete, ever" (Part 5) at the rules level, not just by omitting a
    // delete button in the UI -- mirrors the same pattern already used for
    // /reservations above. Deactivation is a normal field update
    // (active:false), which stays allowed.
    match /service_catalog/{itemId} {
      // Agency Sales Workflow Phase C (2026-09-11): an authenticated agency
      // may read ONE item at a time, only if it's active and explicitly
      // approved for agencies -- same shape as packages/{packageId}'s
      // existing (previously unused) visibleToAgencies clause below, now
      // actually put to use. Nothing is agency-visible by default: an item
      // with no visibleToAgencies field falls through to 'all'-not-matched
      // (resource.data.get() has no default here on purpose -- unlike
      // packages, where the historical default was 'all' for backward
      // compatibility with packages written before this field existed,
      // every service_catalog item predates agency visibility entirely, so
      // defaulting to 'all' here would silently expose the whole catalog).
      // This is a single-document read rule, not an array-validation
      // problem, so it's safe to enforce here directly -- the thing rules
      // genuinely can't do (verify a whole selectedComponents[] array's
      // rates against their sources) is why submitAgencyCustomQuote exists
      // as a Cloud Function instead.
      allow read: if isAdmin() || isStaff() || isManagerRole()
        || (request.auth != null && resource.data.active == true
            && (resource.data.visibleToAgencies == 'all'
                || (resource.data.visibleToAgencies is list
                    && request.auth.token.email.lower() in resource.data.visibleToAgencies)));
      // priceTaxMode (Catalog Tax-Treatment Upgrade, 2026-09-11): optional
      // and backward-compatible -- an item written before this field
      // existed, or one this rule doesn't touch on update, simply has no
      // value and falls back client-side (catalogItemPriceTaxMode()).
      // Validated only when present, so it can never be set to anything
      // other than the two real values. visibleToAgencies (Phase C) is the
      // same kind of optional, validated-only-when-present field.
      allow create, update: if (isAdmin() || isManagerRole())
        && request.resource.data.name is string
        && request.resource.data.category in ['TRIPS_ACTIVITIES','FOOD_BEVERAGE','TRANSFER','OTHER_SERVICE','ACCOMMODATION_EXTRA']
        && request.resource.data.unitType in ['PER_PAX','PER_TRIP','PER_ITEM','PER_NIGHT','PER_ROOM','PER_HOUR']
        && request.resource.data.basePrice is number
        && request.resource.data.basePrice >= 0
        && request.resource.data.active is bool
        && (!('priceTaxMode' in request.resource.data)
            || request.resource.data.priceTaxMode == null
            || request.resource.data.priceTaxMode in ['TAX_INCLUDED','TAX_EXCLUDED'])
        && (!('visibleToAgencies' in request.resource.data)
            || request.resource.data.visibleToAgencies == 'all'
            || request.resource.data.visibleToAgencies is list);
      allow delete: if false;
    }

    // Reservation Document Vault (Part A, Document Vault + Catalog +
    // Invoice Center, 2026-09-10; security-hardened 2026-09-10). One
    // record per uploaded document, metadata only -- the actual file
    // bytes live in Storage under reservation-documents/{resId}/{docId},
    // which storage.rules now denies to every direct client request
    // (`allow read, write: if false`). The real read/write path is the
    // getReservationDocument / uploadReservationDocument Cloud Functions
    // (functions-core/index.js), which use the Admin SDK and therefore
    // never go through this rules file's Storage counterpart at all --
    // this Firestore rule below is a metadata-layer backstop only,
    // reachable by a normal authenticated client write, kept as
    // defense-in-depth even though the callables are now the primary path.
    // Sensitive types (passport/ID/visa) are read-restricted to
    // Admin/Manager only, matching Part A3/F's least-privilege
    // requirement; Staff may read non-sensitive types (signed bills,
    // invoices, receipts, transfer docs, other). Never hard-deleted (A7)
    // -- `allow delete: if false` mirrors reservation_price_adjustments
    // above; ordinary Staff may only toggle status active<->archived
    // (an "Archive" action, not a rewrite of the document's identity),
    // while Admin/Manager may update any field per role policy.
    match /reservation_documents/{docId} {
      allow read: if isAdmin() || isManagerRole()
        || (isStaff() && !(resource.data.type in ['PASSPORT','IDENTITY','TRAVEL']));
      allow create: if (isAdmin() || isManagerRole() || isStaff())
        && request.resource.data.reservationId is string
        && request.resource.data.type in ['PASSPORT','IDENTITY','TRAVEL','TRANSFER','SIGNED_BILL','INVOICE','RECEIPT','OTHER']
        && request.resource.data.title is string
        && request.resource.data.storagePath is string
        && request.resource.data.uploadedByUid == request.auth.uid
        && request.resource.data.uploadedAt == request.time
        && request.resource.data.status == 'active';
      allow update: if isAdmin() || isManagerRole()
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','archivedAt','archivedBy'])
            && request.resource.data.status in ['active','archived']);
      allow delete: if false;
    }

    // Payment-status change audit trail (Part C17). Append-only, mirrors
    // reservation_price_adjustments -- previous status/amount, new
    // status/amount, method, reference, who, and a server timestamp that
    // can't be spoofed by a client clock. Staff may create entries (they
    // can change payment status if their invoice-edit permissions allow
    // it in the UI) but nothing can be edited or deleted after the fact.
    match /invoice_payment_audit/{id} {
      allow read: if isAdmin() || isStaff() || isManagerRole();
      allow create: if (isAdmin() || isStaff() || isManagerRole())
        && request.resource.data.invoiceId is string
        && request.resource.data.previousStatus is string
        && request.resource.data.newStatus is string
        && request.resource.data.changedByUid == request.auth.uid
        && request.resource.data.changedAt == request.time;
      allow update, delete: if false;
    }

    // View/download audit for sensitive reservation documents (security
    // hardening pass, 2026-09-10). Written ONLY by the getReservationDocument
    // Cloud Function via the Admin SDK, which bypasses these rules entirely
    // -- `allow write: if false` here isn't a gap, it's confirmation no
    // client (however authenticated) can forge or tamper with an access
    // record. Read-only for Admin/Manager, matching who's allowed to view
    // the sensitive documents these entries are about.
    match /document_access_audit/{id} {
      allow read: if isAdmin() || isManagerRole();
      allow write: if false;
    }

    match /users/{id} {
      // Full-collection listing (the User Management panel) is admin/staff
      // only; anyone else can only ever read their own profile doc — this
      // is what was missing before: `allow read: if true` let an
      // unauthenticated request list every agency's commission rate, name,
      // and email in one call. isAgency()/isStaff() elsewhere in this file
      // use get() on this same path internally, which bypasses this read
      // rule entirely (rules-internal get()/exists() always succeed), so
      // tightening this doesn't touch that.
      allow read: if isAdmin() || isStaff() || isManagerRole() || (request.auth != null && request.auth.token.email.lower() == id);
      // Self-service writes may never change `role` (existing) or
      // `commission` (added) — both are admin-set fields with no legitimate
      // self-edit path in the app. `uid` is deliberately left self-writable:
      // authenticateUser()/restoreSession() backfill it onto a caller's own
      // doc the first time they log in after an account was created without
      // one, and that's the only place a non-admin ever writes it.
      allow write: if isAdmin() || (
        request.auth != null && request.auth.token.email.lower() == id &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('commission', null) == resource.data.get('commission', null)
      );
    }

    match /staff_permissions/{staffUid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == staffUid);
      allow write: if isAdmin();
    }

    match /admin_settings/security { allow read, write: if isAdmin(); }

    // USD/MVR billing + tax settings (2026-09-10). A dedicated collection,
    // NOT the general /settings/{docId} (staff-writable) -- Part Q
    // requires Admin/Manager only here, and Firestore rules are
    // permissive-OR across every matching block, so reusing /settings/
    // would have let Staff write via that other, broader rule regardless
    // of anything added here. Read is open to any authenticated staff
    // (they need the current rate/mode to understand an invoice, just
    // never to change it).
    match /tax_currency_settings/{docId} {
      allow read: if isAdmin() || isStaff() || isManagerRole();
      allow write: if isAdmin() || isManagerRole();
    }
    // Append-only audit trail for every tax/currency settings change
    // (Part Q) -- same shape as reservation_price_adjustments/
    // invoice_payment_audit/reservation_note_history: field, old/new
    // value, who, and a server timestamp a client can't spoof. Only
    // Admin/Manager may create an entry, matching who may actually change
    // the underlying setting.
    match /tax_settings_audit/{id} {
      allow read: if isAdmin() || isStaff() || isManagerRole();
      allow create: if (isAdmin() || isManagerRole())
        && request.resource.data.field is string
        && request.resource.data.changedByUid == request.auth.uid
        && request.resource.data.changedAt == request.time;
      allow update, delete: if false;
    }
    match /cancellation_attempts/{attemptId} { allow create: if request.auth != null; allow read, update, delete: if false; }

    // ── OTA / channel-manager core (read-only additive rules) ──
    // Every write to these collections happens ONLY through Cloud Functions
    // using the Admin SDK, which bypasses these rules entirely — so no
    // `allow write` clause is needed or given here for any client, including
    // admin/staff. These rules exist solely so the future PMS "Sync log" /
    // "OTA channels" screens can read the real data once built; today
    // nothing in the client reads these collections yet.
    match /ota_config/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if false; }
    match /ota_events/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if false; }
    match /ota_conflicts/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if false; }
    match /ota_pushes/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if false; }
    match /ota_queue/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if false; }
    match /availability_outbound/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if false; }
    // OTA room-type commercial model (Beds24 pre-integration stage, additive):
    // separate from physical-room pricing (room_prices/room_details above) and
    // from live PMS rates -- staff/admin can configure it exactly like any
    // other pricing-adjacent collection, but nothing reads or writes it from
    // the public site, and no Cloud Function pushes it externally yet.
    match /ota_room_types/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if isAdmin() || isStaff() || isManagerRole(); }
    match /ota_room_type_overrides/{id} { allow read: if isAdmin() || isStaff() || isManagerRole(); allow write: if isAdmin() || isStaff() || isManagerRole(); }
    // rate_limits stores only a salted hash + a count, never guest PII; kept
    // fully server-only (not even admin/staff read) since it has no UI use.
    match /rate_limits/{id} { allow read, write: if false; }
    match /block_requests/{id} {
      // Agency Sales Workflow Phase E (2026-09-11): this collection is
      // reused (not duplicated) for the new AGENCY_HOLD request type
      // alongside the pre-existing legacy multi-room group-block request
      // shape (created by submitBlock() in vilu-agency-portal.html, status
      // lowercase 'pending'/'approved'/'rejected', no requestType field).
      // The one addition here closes a real gap: without it, an agency's
      // own create call -- otherwise unrestricted in field shape -- could
      // self-write a request that already claims status:'APPROVED' plus a
      // fabricated blockId/approvedAt/approvedBy/approvedHoldUntil. That
      // could never manufacture a REAL block (blocks stays admin/staff/
      // manager write-only, untouched), but it could spoof this agency's
      // own "My Holds" UI into showing a fake approval. The condition below
      // is written to also accept the legacy shape unchanged (no
      // requestType, lowercase 'pending', these five fields absent) so
      // backward compatibility holds.
      allow create: if request.auth != null && request.resource.data.agencyId == request.auth.uid
        && (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'PENDING'])
        && request.resource.data.get('blockId', null) == null
        && request.resource.data.get('approvedAt', null) == null
        && request.resource.data.get('approvedBy', null) == null
        && request.resource.data.get('approvedHoldUntil', null) == null;
      allow read: if request.auth != null && (isAdmin() || isStaff() || isManagerRole() || resource.data.agencyId == request.auth.uid);
      // Approval/rejection/release all go through Admin-SDK Cloud Functions
      // (approveAgencyHoldRequest/rejectAgencyHoldRequest/
      // releaseAgencyHoldRequest in functions-core/index.js), which bypass
      // this rule entirely -- it stays admin/staff/manager-broad rather
      // than being narrowed further, matching the legacy
      // approveBlockRequest()/rejectBlockRequest() update shape it already
      // covered before this phase.
      allow update: if isAdmin() || isStaff() || isManagerRole();
      allow delete: if false;
    }

    // Agency Sales Workflow Phase F (2026-09-11): a NEW collection, kept
    // separate from agency_quotes/block_requests/reservations per explicit
    // instruction. An agency submits confirmed guest intent here as a
    // direct, rules-gated client write (same shape as block_requests'
    // AGENCY_HOLD create above) -- this alone never creates a reservation.
    // The create rule blocks an agency from pre-claiming her own decision
    // the same way block_requests' create rule does: no self-written
    // CONFIRMED/REJECTED/CHANGE_REQUESTED status, no fabricated
    // reservationId/confirmedAt/confirmedBy.
    match /agency_booking_requests/{id} {
      allow create: if request.auth != null && request.resource.data.agencyId == request.auth.uid
        && (!('status' in request.resource.data) || request.resource.data.status == 'PENDING')
        && request.resource.data.get('reservationId', null) == null
        && request.resource.data.get('confirmedAt', null) == null
        && request.resource.data.get('confirmedBy', null) == null;
      allow read: if request.auth != null && (isAdmin() || isStaff() || isManagerRole() || resource.data.agencyId == request.auth.uid);
      // Confirm/reject/request-change all go through Admin-SDK Cloud
      // Functions (confirmAgencyBookingRequest/rejectAgencyBookingRequest/
      // requestChangeAgencyBookingRequest in functions-core/index.js),
      // which bypass this rule entirely -- it stays admin/staff/manager-
      // broad as the operational backstop, the same shape as
      // block_requests' own update rule above.
      allow update: if isAdmin() || isStaff() || isManagerRole();
      allow delete: if false;
    }

    // Agency Sales Workflow Phase J (2026-09-11): one settlement per
    // confirmed agency reservation. Created ONLY server-side -- inside
    // confirmAgencyBookingRequest's own transaction (Admin SDK) or by the
    // reconcileMissingAgencySettlements maintenance callable (also Admin
    // SDK) -- never by a direct client write, so `allow create: if false`
    // here is not a gap, it is the whole point: amounts/direction are
    // computed once from the reservation's own immutable snapshot and
    // never client-supplied. Every real status transition
    // (PAYABLE -> PAYMENT_SENT -> RECEIVED, or -> DISPUTED) goes through
    // its own direction-aware Cloud Function -- update here stays
    // admin/staff/manager-broad purely as the same operational backstop
    // every other collection in this file uses, not a client write path
    // for financial fields.
    match /agency_settlements/{id} {
      allow read: if request.auth != null && (isAdmin() || isStaff() || isManagerRole() || resource.data.agencyId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin() || isStaff() || isManagerRole();
      allow delete: if false;
    }

    // Append-only audit trail for every agency_settlements status change --
    // written only by the Cloud Functions above (Admin SDK). No client,
    // including Admin's own UI, may write here directly; an agency may
    // read only her own settlement's history (transparency into money
    // that was sent to or by her own agency), never rewrite it.
    match /agency_settlement_audit/{id} {
      allow read: if request.auth != null && (isAdmin() || isStaff() || isManagerRole() || resource.data.agencyId == request.auth.uid);
      allow write: if false;
    }

    // ── Multi-Property Availability (Part 2/21/24) ──────────────────────
    // Vilu Residence itself is never a doc here (see functions-core/
    // index.js's own comment on why) -- only partner properties live in
    // this collection. notesInternal and any future internal-only field
    // stay admin/staff/manager-only at the WHOLE-DOCUMENT level (same
    // limitation as reservations/blocks -- rules cannot redact individual
    // fields), so an agency's direct read is deliberately narrow: active +
    // visibleToAgencies only, and even then the agency-facing app reads
    // through getAgencyProperties()/getAgencyPropertyRoomTypes() (Admin
    // SDK, explicit field allowlist) rather than this rule directly, so
    // notesInternal never actually reaches an agency client either way --
    // this rule is the operational backstop, not the only safeguard.
    match /accommodation_properties/{propertyId} {
      allow read: if isAdmin() || isStaff() || isManagerRole()
        || (request.auth != null && resource.data.active == true && resource.data.visibleToAgencies == true);
      allow write: if isAdmin() || isStaff() || isManagerRole();

      match /room_types/{roomTypeId} {
        allow read: if isAdmin() || isStaff() || isManagerRole()
          || (request.auth != null && resource.data.active == true && resource.data.visibleToAgencies == true);
        allow write: if isAdmin() || isStaff() || isManagerRole();

        // One doc holding a {date: true} map of blocked dates for this
        // room type (Part 22: "keep it practical", not a second PMS) --
        // admin/staff/manager entered and read only; agencies never read
        // this directly (getAgencyAvailability's Admin-SDK path reads it
        // instead, returning only AVAILABLE/BLOCKED/ON_REQUEST per date,
        // Part 3/10).
        match /manual_availability/{docId} {
          allow read, write: if isAdmin() || isStaff() || isManagerRole();
        }
      }
    }

    // Multi-Property Availability (Part 16/17): an agency's own request for
    // a partner-property stay -- never a reservations doc (Part 23), never
    // self-confirmable (Part 17: confirm/reject go through the Admin-SDK
    // callables above, which bypass this rule; update here is the same
    // admin/staff/manager operational backstop every other collection in
    // this file uses).
    match /accommodation_booking_requests/{id} {
      allow create: if request.auth != null && request.resource.data.agencyId == request.auth.uid
        && request.resource.data.status == 'AVAILABILITY_REQUESTED'
        && request.resource.data.get('confirmedAt', null) == null
        && request.resource.data.get('confirmedBy', null) == null
        && request.resource.data.get('rejectedAt', null) == null
        && request.resource.data.get('rejectedBy', null) == null;
      allow read: if request.auth != null && (isAdmin() || isStaff() || isManagerRole() || resource.data.agencyId == request.auth.uid);
      allow update: if isAdmin() || isStaff() || isManagerRole();
      allow delete: if false;
    }

    match /packages/{packageId} {
      allow read: if isAdmin() || isStaff() || isManagerRole()
        || resource.data.get('visibleToAgencies', 'all') == 'all'
        || (request.auth != null
            && resource.data.visibleToAgencies is list
            && request.auth.token.email.lower() in resource.data.visibleToAgencies);
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    // Per-agency package copies - each agency's own customized package set,
    // keyed by their email. Only that specific agency (or admin) can read it;
    // only admin can write it (matches how packages/room_details are admin-managed).
    match /agency_packages/{email} {
      allow read: if request.auth != null &&
        (request.auth.token.email.lower() == email || isAdmin());
      allow write: if isAdmin();
    }

    // Agency Sales Workflow Phase A (2026-09-11): each agency's own private
    // quotes -- Vilu's net cost stays private to that agency, the agency
    // sets its own guest selling total (see agency_quotes model in
    // vilu-agency-portal.html's createDraftAgencyQuote()). Keyed by agencyId
    // (the Firebase Auth uid), matching the existing reservations/
    // block_requests convention -- NOT by email like agency_packages above.
    // No quote is ever created/read by anything but its own owning agency
    // or Admin/Staff/Manager; there is no broad-collection read anywhere.
    match /agency_quotes/{quoteId} {
      // Agency Sales Workflow Phase C (2026-09-11): a CUSTOM_PACKAGE quote's
      // selectedComponents rates can only be verified server-side (rules
      // have no loop to fetch-and-check each array entry against its
      // source doc -- see submitAgencyCustomQuote's own comment in
      // functions-core/index.js for the full reasoning). That Cloud
      // Function uses the Admin SDK, which bypasses these rules entirely,
      // so restricting the CLIENT'S direct create/update to
      // quoteType=='ASSIGNED_PACKAGE' only closes the one path an agency
      // could otherwise use to bypass server validation (writing a
      // CUSTOM_PACKAGE doc directly with a spoofed rate) -- it does not
      // affect the Cloud Function's own writes, and does not change
      // ASSIGNED_PACKAGE quotes (Phase B), which never needed server
      // verification since their rate is the agency's own already-owned
      // agency_packages data.
      allow create: if request.auth != null
        && request.resource.data.agencyId == request.auth.uid
        && request.resource.data.quoteType == 'ASSIGNED_PACKAGE';

      allow read: if request.auth != null
        && (isAdmin() || isStaff() || isManagerRole() || resource.data.agencyId == request.auth.uid);

      // Owning agency may update its own quote only while it is still
      // DRAFT, and can never change which agency owns it. Once FINALIZED,
      // only Admin/Staff/Manager can touch it -- Phase A's deliberately
      // simple immutability gate; no versioning/history yet (Part 6: "do
      // not over-engineer versioning yet"). Same quoteType=='ASSIGNED_PACKAGE'
      // restriction as create above -- a CUSTOM_PACKAGE quote can only ever
      // be updated through submitAgencyCustomQuote (Admin SDK) or by
      // Admin/Staff/Manager.
      //
      // Calendar-fix follow-up: a direct client write may still finalize an
      // ASSIGNED_PACKAGE quote (unchanged, zero behavior change) ONLY when
      // its accommodation is Vilu itself -- the package's own agencyPricePerRoom
      // is the agency's already-owned data, nothing to spoof. Finalizing
      // with a partner property requires a trusted Vilu-controlled rate
      // override that only the server can look up and verify, so that one
      // transition is refused here and must go through
      // finalizeAgencyAssignedPackageQuote (Admin SDK, bypasses this rule)
      // instead -- see the comment above that export.
      allow update: if isAdmin() || isStaff() || isManagerRole()
        || (request.auth != null
            && resource.data.agencyId == request.auth.uid
            && request.resource.data.agencyId == resource.data.agencyId
            && resource.data.status == 'DRAFT'
            && resource.data.quoteType == 'ASSIGNED_PACKAGE'
            && (request.resource.data.status != 'FINALIZED'
                || !('accommodationPropertyId' in request.resource.data)
                || request.resource.data.accommodationPropertyId == 'VILU'));

      allow delete: if false;
    }

    match /room_prices/{roomId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    match /room_details/{roomId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff() || isManagerRole();
    }

    // Guest reviews - manually entered OTA reviews + platform aggregate
    // ratings. Admin-only write (matches the Transportation panel's
    // admin-only access pattern), public read so the website can display
    // reviews without requiring a login.
    match /manual_reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /platform_ratings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
