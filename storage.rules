rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Cross-service rules (checking Firestore's staff_permissions from here,
    // the same way Firestore's own rules do) proved unreliable in this
    // project even after granting the Firebase Rules service agent
    // datastore.viewer - admin-only for now; staff-photo-upload access can
    // be revisited once that's resolved. Firestore rules for room_details
    // (which staff DO still fully manage) are unaffected by this.
    function isAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'viluresidence@gmail.com';
    }

    // Phase 50 media/storage safety audit (2026-09-08): all three admin-write
    // paths below previously allowed any content type/size from the admin
    // account, with no MIME or size check at the rules level. Since these
    // objects are served with public read access, an accidental (or
    // credential-compromise) upload of an HTML/SVG file could be served
    // inline and create a stored-XSS surface; an uncapped size also had no
    // cost/quota guard. Added an image-only content-type check and a 15MB
    // cap to each — additive, reversible (rules-only deploy), doesn't change
    // any currently-working upload of a real photo.
    function isValidImageUpload() {
      return request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /room-photos/{roomId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageUpload();
    }

    // Descriptively-named SEO-mirror copies written alongside each
    // room-photos upload (Room Photo SEO Architecture, Phase 1) — same
    // public-read/admin-write shape as room-photos itself. Not yet read by
    // the website; exists so a future one-time Hosting migration always has
    // an up-to-date, correctly-named source instead of drifting silently.
    match /room-photos-seo/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageUpload();
    }

    // General website content images (currently: the About section's
    // property photo) - same public-read/admin-write shape as room-photos,
    // for site assets that aren't tied to a specific room.
    match /site-assets/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageUpload();
    }

    // Optional signed-bill photo attached to one Guest Folio line item
    // (2026-09-10 folio unification). Reuses the EXACT existing
    // upload/resize/delete mechanism and the same admin-only gate as
    // room-photos above -- not a new backend/security architecture, just
    // one more path under the same pattern. Known limitation, reported per
    // that task's own instruction rather than silently worked around:
    // isAdmin() here is hardcoded to a single email (see the comment at the
    // top of this file on why a broader isStaff() check proved unreliable
    // from Storage rules), so today ONLY that admin account can attach a
    // bill photo -- regular staff cannot. Fixing that would mean revisiting
    // the cross-service role check this file's own history already notes
    // was abandoned once; out of scope for this pass.
    match /folio-attachments/{resId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageUpload();
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
