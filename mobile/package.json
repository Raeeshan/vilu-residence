{
  "name": "vilu-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:staff": "cross-env APP_VARIANT=staff expo start",
    "start:agency": "cross-env APP_VARIANT=agency expo start",
    "android:staff": "cross-env APP_VARIANT=staff expo run:android",
    "android:agency": "cross-env APP_VARIANT=agency expo run:android",
    "ios:staff": "cross-env APP_VARIANT=staff expo run:ios",
    "ios:agency": "cross-env APP_VARIANT=agency expo run:ios",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eas-build-pre-install": "node scripts/eas-select-google-services.js"
  },
  "dependencies": {
    "@react-native-firebase/app": "^20.0.0",
    "@react-native-firebase/app-check": "^20.0.0",
    "@react-native-firebase/auth": "^20.0.0",
    "@react-native-firebase/crashlytics": "^20.0.0",
    "@react-native-firebase/firestore": "^20.0.0",
    "@react-native-firebase/functions": "^20.0.0",
    "@react-native-firebase/messaging": "^20.0.0",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.0",
    "expo-dev-client": "~4.0.29",
    "expo-linking": "~6.3.0",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.0",
    "expo-splash-screen": "~0.27.0",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
