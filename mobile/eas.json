{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/packages/eas-cli/schema/build-profile-schema.json",
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development-staff": {
      "extends": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "staff" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "development-agency": {
      "extends": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "agency" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "staff" },
      "android": { "buildType": "apk" }
    },
    "preview-staff": {
      "extends": "development-staff",
      "distribution": "internal",
      "developmentClient": false
    },
    "preview-agency": {
      "extends": "development-agency",
      "distribution": "internal",
      "developmentClient": false
    },
    "production-staff": {
      "env": { "APP_VARIANT": "staff" },
      "android": { "buildType": "app-bundle" },
      "autoIncrement": true
    },
    "production-agency": {
      "env": { "APP_VARIANT": "agency" },
      "android": { "buildType": "app-bundle" },
      "autoIncrement": true
    }
  },
  "submit": {
    "production-staff": {},
    "production-agency": {}
  }
}
