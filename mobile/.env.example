# Vilu Mobile — environment template. Copy to .env.local (git-ignored) and
# fill in real values. Never commit real secrets.
#
# Which app identity this build/run targets: "staff" or "agency".
APP_VARIANT=staff

# Native Firebase config files (NOT committed to this repo -- see
# mobile/README.md "Firebase project setup"). Paths are relative to
# mobile/ once you've downloaded them from the Firebase console for the
# EXISTING "vilu-residence" project, after registering the iOS/Android
# app identities (com.viluresidence.staff / com.viluresidence.agency).
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
