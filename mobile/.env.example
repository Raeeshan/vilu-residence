# Vilu Mobile — environment template. Copy to .env.local (git-ignored) and
# fill in real values. Never commit real secrets.
#
# Which app identity this build/run targets: "staff" or "agency".
APP_VARIANT=staff

# Native Firebase config files (NOT committed to this repo -- see
# mobile/README.md "Firebase project setup"). The four app identities are
# already registered under the existing "vilu-residence" project as of
# Phase M1.5. app.config.ts already defaults to
# native-config/<APP_VARIANT>/{google-services.json,GoogleService-Info.plist}
# -- only set these if you want to override that default path.
# GOOGLE_SERVICES_JSON=./native-config/staff/google-services.json
# GOOGLE_SERVICES_PLIST=./native-config/staff/GoogleService-Info.plist
